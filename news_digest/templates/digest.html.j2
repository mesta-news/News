<!doctype html>
<html lang="en">
<head>
<title>The Daily Brief · {{ d.date_label }}</title>
{% include "_head.html.j2" %}
<style>
  /* One colour per tab (from config.yaml); used for the tab, its page and its notifications. */
  {% for s in d.sections if s.color %}[data-cat="{{ s.id }}"] { --cat: {{ s.color[0] }}; }
  {% endfor %}
  @media (prefers-color-scheme: dark) {
    {% for s in d.sections if s.color %}[data-cat="{{ s.id }}"] { --cat: {{ s.color[1] or s.color[0] }}; }
    {% endfor %}
  }
  [data-cat] .kicker, [data-cat].kicker { color: var(--cat); }

  /* Section tabs */
  .tabs { display: flex; gap: 20px; overflow-x: auto; scrollbar-width: none; margin: 0 -16px;
          padding: 0 16px; -webkit-overflow-scrolling: touch; border-top: 1px solid var(--rule);
          overscroll-behavior-x: contain; scroll-padding: 0 32px; }
  /* Fade the edges of horizontal strips so it's clear there is more to scroll. */
  .tabs, .ticker-row { -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent);
                       mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent); }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs a { flex: none; padding: 10px 0 9px; font: 700 .72rem/1 var(--sans); letter-spacing: .08em;
            text-transform: uppercase; color: var(--muted); text-decoration: none;
            border-bottom: 3px solid transparent; white-space: nowrap; }
  .tabs a.active { color: var(--ink); border-bottom-color: var(--claret); }
  .tabs .count { margin-left: 4px; padding: 1px 5px; border-radius: 8px; background: var(--panel);
                 color: var(--muted); font-size: .64rem; letter-spacing: 0; }
  .tabs a::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 6px;
                    border-radius: 2px; background: var(--cat, var(--claret)); vertical-align: 1px; }
  .tabs a.unread::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 5px;
                         border-radius: 50%; background: var(--cat, var(--claret)); vertical-align: 2px; }
  .tabs a.active { color: var(--cat, var(--ink)); border-bottom-color: var(--cat, var(--claret)); }
  .tabs a.active::after { display: none; }
  .tabs a.active .count { background: var(--cat, var(--claret)); color: var(--paper); }

  /* Black market ticker */
  .ticker { background: var(--tick-bg); color: var(--tick-ink); }
  .ticker-row { display: flex; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px;
                -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  .ticker-row::-webkit-scrollbar { display: none; }
  .tick { flex: none; display: flex; align-items: baseline; gap: 7px; padding: 10px 16px 10px 0; margin-right: 16px;
          border-right: 1px solid #262626; font-size: .76rem; white-space: nowrap;
          color: inherit; text-decoration: none; }
  .tick:hover .tick-name, .tick:focus-visible .tick-name { color: var(--tick-ink); }
  .tick:last-child { border-right: 0; }
  .tick-name { color: var(--tick-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; font-size: .68rem; }
  .tick-val { font-weight: 700; }
  .tick .up { color: var(--tick-up); } .tick .down { color: var(--tick-down); } .tick .flat { color: var(--tick-muted); }

  /* Panels */
  .js .panel { display: none; }
  .js .panel.active { display: block; animation: fade .15s ease-out; }
  @keyframes fade { from { opacity: .5; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .js .panel.active { animation: none; } }
  .panel { padding-top: 22px; }
  .panel-head { padding-bottom: 12px; margin-bottom: 18px; border-bottom: 4px solid var(--cat, var(--rule-strong)); }
  .panel-head h2 { margin: 6px 0 0; font: 600 clamp(1.7rem, 6.5vw, 2.3rem)/1.1 var(--serif); letter-spacing: -.015em; }
  .panel-head .meta { margin-top: 6px; }

  /* Front page */
  .dateline { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px 12px;
              padding: 8px 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong);
              font-size: .74rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); }
  .front-title { margin: 18px 0 2px; font: 600 clamp(1.9rem, 7.5vw, 2.8rem)/1.05 var(--serif); letter-spacing: -.02em; }
  .minute { margin: 20px 0 8px; padding: 16px 18px 6px; background: var(--panel); border-top: 4px solid var(--claret); }
  .minute ol { list-style: none; margin: 10px 0 0; padding: 0; }
  .minute li { padding: 10px 0 12px; border-top: 1px solid var(--rule); }
  .minute li:first-child { border-top: 0; padding-top: 2px; }
  .minute .kicker a { text-decoration: none; }
  .minute p { margin: 3px 0 0; font: 400 1.05rem/1.45 var(--serif); color: var(--ink); }

  .cards { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 18px; }
  @media (min-width: 720px) { .cards { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  .card { padding: 14px 0 18px; border-top: 3px solid var(--cat, var(--rule)); }
  .card-title { display: block; margin: 6px 0 4px; font: 600 1.22rem/1.25 var(--serif); text-decoration: none; }
  .card-title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .standfirst { margin: 0; color: var(--ink-2); font-size: .92rem; }
  .card ul { list-style: none; margin: 10px 0 0; padding: 0; }
  .card li { padding: 7px 0 0; font: 500 .92rem/1.35 var(--serif); }
  .card li a { text-decoration: none; }
  .card li a:hover { text-decoration: underline; }
  .more { display: inline-block; margin-top: 10px; font: 700 .7rem/1 var(--sans); letter-spacing: .08em;
          text-transform: uppercase; color: var(--cat, var(--claret)); text-decoration: none; }

  /* Section body */
  .brief { font-size: .98rem; }
  .brief ul { margin: 0; padding: 0; list-style: none; }
  .brief li { position: relative; padding: 0 0 12px 16px; margin: 0 0 12px; border-bottom: 1px solid var(--rule); }
  .brief li:last-child { border-bottom: 0; margin-bottom: 0; }
  .brief li::before { content: ""; position: absolute; left: 0; top: .55em; width: 7px; height: 7px; background: var(--cat, var(--claret)); }
  .brief p { margin: 0 0 12px; }
  .brief strong { font: 700 1.02rem/1.3 var(--serif); }

  .foryou { margin: 18px 0 4px; padding: 14px 16px; background: var(--teal-soft); border-left: 4px solid var(--cat, var(--teal));
            background: color-mix(in srgb, var(--cat, var(--teal)) 10%, var(--paper)); }
  .foryou ul { margin: 8px 0 0; padding-left: 18px; }
  .foryou li { margin: 0 0 6px; font-size: .94rem; }
  .foryou li:last-child { margin-bottom: 0; }

  .radar { margin: 18px 0 4px; padding: 12px 16px; border: 1px solid var(--rule-strong); background: var(--card); }
  .radar ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .radar li { display: flex; gap: 12px; padding: 7px 0; border-top: 1px solid var(--rule); font-size: .92rem; }
  .radar li:first-child { border-top: 0; }
  .radar .when { flex: none; min-width: 64px; font-weight: 700; color: var(--cat, var(--claret)); font-variant-numeric: tabular-nums; }
  .stale { margin: 10px 0 0; padding: 8px 12px; font-size: .8rem; background: var(--alert-soft); color: var(--alert); }
  .alert { margin: 0 0 16px; padding: 12px 14px; background: var(--alert-soft); color: var(--alert); font-size: .9rem; }
  .alert a { font-weight: 700; }
  .alert pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .78rem; margin: 8px 0 0; color: var(--ink); }

  /* Data tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1px;
           margin: 0 0 22px; padding: 1px; }
  @media (max-width: 360px) { .tiles { grid-template-columns: 1fr 1fr; } }
  .tile { display: block; min-width: 0; padding: 11px 12px 10px; background: var(--card); text-decoration: none;
          box-shadow: 0 0 0 1px var(--rule); scroll-margin-top: 120px; }
  .tile:hover { background: var(--paper); }
  .tile.flash { animation: flash 1.6s ease-out; }
  @keyframes flash { 0%, 40% { box-shadow: 0 0 0 2px var(--claret); } 100% { box-shadow: 0 0 0 1px var(--rule); } }
  .tile-group { margin: 0 0 6px; }
  .tile-group + .tiles { margin-bottom: 18px; }
  .tile-name { font-size: .78rem; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .tile-sub { font-size: .68rem; color: var(--faint); }
  .tile-val { margin-top: 5px; font-size: 1.22rem; font-weight: 700; letter-spacing: -.01em; }
  .tile-chg { display: flex; flex-wrap: wrap; gap: 3px 8px; margin-top: 2px; font-size: .72rem; font-weight: 600; }
  .pill { display: inline-block; padding: 0 5px; border-radius: 3px; }
  .pill.up { background: var(--up-soft); } .pill.down { background: var(--down-soft); }
  .tile svg { display: block; width: 100%; height: 26px; margin-top: 7px; }
  .tile-empty { color: var(--faint); font-size: .78rem; margin-top: 8px; }

  /* Stories */
  .label { margin: 26px 0 0; padding-top: 8px; border-top: 1px solid var(--rule-strong); }
  [data-cat] .group-label { margin: 18px 0 0; color: var(--ink-2); }
  .stories { list-style: none; margin: 0; padding: 0; }
  .stories li { padding: 13px 0; border-bottom: 1px solid var(--rule); }
  .stories li:last-child { border-bottom: 0; }
  .stories .src { font: 700 .66rem/1.2 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--cat, var(--teal)); }
  .stories a.hl { display: block; margin-top: 3px; font: 600 1.06rem/1.32 var(--serif); text-decoration: none; }
  .stories a.hl:hover { text-decoration: underline; text-underline-offset: 3px; }
  .stories .meta { margin-top: 3px; }
  .why { margin-top: 5px; font-size: .9rem; color: var(--ink-2); }
  .snippet { margin-top: 5px; font-size: .88rem; color: var(--ink-2);
             display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .empty { margin: 4px 0; color: var(--muted); font: italic 1rem var(--serif); }

  details { margin-top: 6px; }
  a, button, summary { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .minute li[data-cat] { padding-left: 12px; border-left: 3px solid var(--cat); }

  /* Notification settings */
  dialog.notify { width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); overflow: auto;
                  padding: 20px; border: 0; border-radius: 14px; background: var(--card); color: var(--ink);
                  box-shadow: 0 20px 60px rgba(0,0,0,.35); }
  dialog.notify::backdrop { background: rgba(0,0,0,.45); }
  .notify h3 { margin: 0 0 4px; font: 600 1.4rem/1.2 var(--serif); }
  .notify p { margin: 6px 0; font-size: .9rem; color: var(--ink-2); }
  .notify .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; margin: 12px 0; }
  .notify label.choice { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: .9rem; cursor: pointer; }
  .notify label.choice input { width: 18px; height: 18px; accent-color: var(--cat, var(--claret)); }
  .notify label.choice .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--cat, var(--claret)); flex: none; }
  .notify input[type=text], .notify textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--rule); border-radius: 8px;
                                               background: var(--paper); color: var(--ink); font: 400 .9rem var(--sans); }
  .notify textarea { height: 86px; font: 400 .72rem/1.35 ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }
  .notify .row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .notify button.btn { padding: 10px 14px; border: 0; border-radius: 8px; font: 700 .85rem var(--sans); cursor: pointer;
                       background: var(--claret); color: #fff; }
  .notify button.btn.ghost { background: var(--panel); color: var(--ink); }
  .notify ol { margin: 8px 0; padding-left: 20px; font-size: .86rem; color: var(--ink-2); }
  .notify .status { min-height: 1.2em; font-size: .85rem; font-weight: 600; color: var(--alert); }
  .notify .status.ok { color: var(--up); }

  details summary { cursor: pointer; list-style: none; padding: 10px 0; font: 700 .7rem/1 var(--sans);
                    letter-spacing: .08em; text-transform: uppercase; color: var(--claret); }
  details summary::-webkit-details-marker { display: none; }
  details summary::after { content: " +"; }
  details[open] summary::after { content: " −"; }
  .older a.hl { font-size: .94rem; font-weight: 500; }
  .watching { margin-top: 14px; font-size: .76rem; color: var(--muted); }
  .watching a { color: var(--muted); }
  .errors ul { margin: 0; padding-left: 18px; font-size: .74rem; color: var(--muted); }
  .errors summary { color: var(--faint); }
</style>
</head>
<body data-edition="{{ d.date }} {{ d.generated_label }}" data-date="{{ d.date }}">
{%- macro story(i) %}
      <li>
        <div class="src">{{ i.sources[0] }}{% if i.sources | length > 1 %} +{{ i.sources | length - 1 }}{% endif %}</div>
        <a class="hl" href="{{ i.link }}" target="_blank" rel="noopener">{{ i.title }}</a>
        {% if i.note %}<div class="why">{{ i.note }}</div>
        {% elif i.snippet %}<div class="snippet">{{ i.snippet }}</div>{% endif %}
        <div class="meta">{{ i.published | shortdate }}</div>
      </li>
{%- endmacro %}
{%- macro tile_id(sec, x) %}t-{{ sec }}-{{ (x.symbol or x.id or x.name) | lower | replace("^", "") | replace("=", "") | replace(".", "") | replace("/", "") | replace(" ", "") | truncate(40, true, "") }}{% endmacro -%}
{%- set ticks = [] -%}
{%- for s in d.sections %}{% for q in s.quotes or [] if q.price is not none %}{% set _ = ticks.append((s.id, q)) %}{% endfor %}{% endfor -%}
{%- set rate_ticks = [] -%}
{%- for s in d.sections %}{% for r in (s.rates or [])[:4] if r.value is not none %}{% set _ = rate_ticks.append((s.id, r)) %}{% endfor %}{% endfor -%}

<header class="appbar">
  <div class="wrap">
    <div class="appbar-row">
      <a class="icon-btn" href="archive.html" aria-label="Past editions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M10 13h4"/></svg>
      </a>
      <a class="brand" href="#today" data-tab="today">The Daily Brief<span>.</span></a>
      <div class="appbar-end">
        {% if vapid_public_key %}
        <button class="icon-btn" id="bell" type="button" aria-label="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        </button>
        {% endif %}
        <button class="icon-btn refresh" type="button" aria-label="Refresh" onclick="location.reload()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        </button>
      </div>
    </div>
    <nav class="tabs" aria-label="Sections">
      <a href="#today" data-tab="today">Today</a>
      {% for s in d.sections %}<a href="#{{ s.id }}" data-tab="{{ s.id }}" data-cat="{{ s.id }}">{{ s.short or s.title }}{% if s.new_count %}<span class="count num">{{ s.new_count }}</span>{% endif %}</a>{% endfor %}
    </nav>
  </div>
</header>

{% if ticks or rate_ticks %}
<div class="ticker" aria-label="Markets">
  <div class="wrap"><div class="ticker-row">
    {% for sid, q in ticks %}
    <a class="tick num" href="#{{ sid }}" data-tab="{{ sid }}" data-focus="{{ tile_id(sid, q) }}"><span class="tick-name">{{ q.name }}</span><span class="tick-val">{{ q.price | price }}</span>{% if q.d1 is not none %}<span class="{{ q.d1 | updown }}">{{ q.d1 | pct(2) }}</span>{% endif %}</a>
    {% endfor %}
    {% for sid, r in rate_ticks %}
    <a class="tick num" href="#{{ sid }}" data-tab="{{ sid }}" data-focus="{{ tile_id(sid, r) }}"><span class="tick-name">{{ r.name }}</span><span class="tick-val">{{ r | rateval }}</span>{% if r.m1 is not none %}<span class="{{ r.m1 | updown }}">{{ r.m1 | bp }}</span>{% endif %}</a>
    {% endfor %}
  </div></div>
</div>
{% endif %}

<main class="wrap">

  <article class="panel" id="tab-today" data-panel="today">
    <div class="dateline"><span>{{ d.date_label }}</span><span>Edition {{ d.generated_label }}</span></div>
    <h1 class="front-title">Today's brief</h1>
    <div class="meta">{{ d.sections | sum(attribute="new_count") }} new stories across {{ d.sections | length }} sections</div>
    <div class="offline">You're offline. Showing the last saved edition.</div>
    <div class="stale" hidden>This edition is from {{ d.date_label }}. Today's run may have failed; check the Actions tab on GitHub.</div>

    {% if d.top %}
    <div class="minute">
      <div class="kicker" style="color:var(--claret)">In one minute</div>
      <ol>
        {% for b in d.top %}
        {% if b is mapping %}
        {% set sec = d.sections | selectattr("id", "equalto", b.section) | first %}
        <li data-cat="{{ b.section }}"><div class="kicker"><a href="#{{ b.section }}" data-tab="{{ b.section }}">{{ sec.short or sec.title if sec else b.section }}</a></div><p>{{ b.text }}</p></li>
        {% else %}<li><p>{{ b }}</p></li>{% endif %}
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    <div class="cards">
      {% for s in d.sections %}
      {% set lead = s.briefing.summary | lead if s.briefing else none %}
      {% set fresh = s["items"] | selectattr("is_new") | list %}
      <div class="card" data-cat="{{ s.id }}">
        <div class="kicker">{{ s.short or s.title }}</div>
        {% if lead and lead.head %}
        <a class="card-title" href="#{{ s.id }}" data-tab="{{ s.id }}">{{ lead.head }}</a>
        {% if lead.body %}<p class="standfirst">{{ lead.body }}</p>{% endif %}
        {% elif fresh %}
        <a class="card-title" href="{{ fresh[0].link }}" target="_blank" rel="noopener">{{ fresh[0].title }}</a>
        {% else %}
        <p class="empty">Nothing new today.</p>
        {% endif %}
        {% if fresh %}
        <ul>{% for i in fresh[(0 if lead and lead.head else 1):][:2] %}<li><a href="{{ i.link }}" target="_blank" rel="noopener">{{ i.title }}</a></li>{% endfor %}</ul>
        {% endif %}
        <a class="more" href="#{{ s.id }}" data-tab="{{ s.id }}">Open {{ s.short or s.title }} →</a>
      </div>
      {% endfor %}
    </div>
  </article>

  {% for s in d.sections %}
  <article class="panel" id="tab-{{ s.id }}" data-panel="{{ s.id }}" data-cat="{{ s.id }}">
    <div class="panel-head">
      <div class="kicker">{{ s.short or s.title }}</div>
      <h2>{{ s.title }}</h2>
      <div class="meta">{{ s.new_count }} new stor{{ "y" if s.new_count == 1 else "ies" }} · {{ d.date_label }}</div>
    </div>

    {% for p in s.pages if p.status in ("changed", "error") %}
    <div class="alert">
      {% if p.status == "changed" %}<div class="kicker" style="color:inherit">Official page changed</div>
        <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>
      {% else %}Couldn't check <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>{% endif %}
      {% if p.diff %}<pre>{{ p.diff }}</pre>{% endif %}
    </div>
    {% endfor %}

    {% if s.quotes %}
    {% set qgroups = s.quotes | map(attribute="group") | map("default", "", true) | unique | list %}
    {% for g in qgroups %}
    {% if g and qgroups | length > 1 %}<div class="kicker tile-group">{{ g }}</div>{% endif %}
    <div class="tiles">
      {% for q in s.quotes if (q.group or "") == g %}
      <a class="tile" id="{{ tile_id(s.id, q) }}" href="https://finance.yahoo.com/quote/{{ q.symbol | urlencode }}" target="_blank" rel="noopener">
        <div class="tile-name">{{ q.name }}</div>
        <div class="tile-sub">{{ q.symbol }}{% if q.unit %} · {{ q.unit }}{% endif %}</div>
        {% if q.price is not none %}
        <div class="tile-val num">{{ q.price | price }}</div>
        <div class="tile-chg num">
          {% if q.d1 is not none %}<span class="pill {{ q.d1 | updown }}">{{ q.d1 | pct(1) }}</span>{% endif %}
          {% if q.w1 is not none %}<span class="{{ q.w1 | updown }}">{{ q.w1 | pct(1) }} 1W</span>{% endif %}
          {% if q.m1 is not none %}<span class="{{ q.m1 | updown }}">{{ q.m1 | pct(1) }} 1M</span>{% endif %}
          {% if q.ytd is not none %}<span class="{{ q.ytd | updown }}">{{ q.ytd | pct(1) }} YTD</span>{% endif %}
        </div>
        {{ q.spark | spark }}
        {% if q.as_of %}<div class="tile-sub">as of {{ q.as_of | shortdate }}</div>{% endif %}
        {% else %}<div class="tile-empty">No data</div>{% endif %}
      </a>
      {% endfor %}
    </div>
    {% endfor %}
    {% endif %}
    {% if s.rates %}
    {% if s.rates_label %}<div class="kicker tile-group">{{ s.rates_label }}</div>{% endif %}
    <div class="tiles">
      {% for r in s.rates %}
      <a class="tile" id="{{ tile_id(s.id, r) }}" href="{{ r.url or ('https://fred.stlouisfed.org/series/' ~ (r.id | urlencode)) }}" target="_blank" rel="noopener">
        <div class="tile-name">{{ r.name }}</div>
        <div class="tile-sub">{{ r.region }}</div>
        {% if r.value is not none %}
        <div class="tile-val num">{{ r | rateval }}</div>
        <div class="tile-chg num">
          {% if r.m1 is not none %}<span><span class="pill {{ r.m1 | updown }}">{{ r.m1 | bp }}</span> 1M</span>{% endif %}
          {% if r.y1 is not none %}<span><span class="pill {{ r.y1 | updown }}">{{ r.y1 | bp }}</span> 1Y</span>{% endif %}
        </div>
        {{ r.spark | spark }}
        <div class="tile-sub">as of {{ r.as_of | shortdate }}</div>
        {% else %}<div class="tile-empty">No data</div>{% endif %}
      </a>
      {% endfor %}
    </div>
    {% endif %}


    {% if s.briefing %}
    <div class="brief">{{ s.briefing.summary | md }}</div>
    {% if s.briefing.on_radar %}
    <div class="radar">
      <div class="kicker">On the radar</div>
      <ul>{% for e in s.briefing.on_radar %}{% set when, _, what = e.partition(": ") %}<li>{% if what %}<span class="when">{{ when }}</span><span>{{ what }}</span>{% else %}<span>{{ e }}</span>{% endif %}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% if s.briefing.for_you %}
    <div class="foryou">
      <div class="kicker">What it means for you</div>
      <ul>{% for f in s.briefing.for_you %}<li>{{ f }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% endif %}

    {% set new_items = s["items"] | selectattr("is_new") | list %}
    {% set old_items = s["items"] | rejectattr("is_new") | list %}
    {% if new_items and s.groups %}
    <div class="kicker label">Stories</div>
    {% for g in s.groups %}
    {% set gi = new_items | selectattr("group", "equalto", g) | list %}
    {% if gi %}
    <div class="kicker group-label">{{ g }}</div>
    <ul class="stories">{% for i in gi[:5] %}{{ story(i) }}{% endfor %}</ul>
    {% if gi | length > 5 %}
    <details><summary>More from {{ g }} ({{ gi[5:] | length }})</summary>
      <ul class="stories">{% for i in gi[5:] %}{{ story(i) }}{% endfor %}</ul>
    </details>
    {% endif %}
    {% endif %}
    {% endfor %}
    {% set other = new_items | rejectattr("group", "in", s.groups) | list %}
    {% if other %}
    <div class="kicker group-label">Other</div>
    <ul class="stories">{% for i in other[:5] %}{{ story(i) }}{% endfor %}</ul>
    {% endif %}
    {% elif new_items %}
    <div class="kicker label">Stories</div>
    <ul class="stories">{% for i in new_items[:6] %}{{ story(i) }}{% endfor %}</ul>
    {% if new_items | length > 6 %}
    <details><summary>More stories ({{ new_items[6:s.max_items] | length }})</summary>
      <ul class="stories">{% for i in new_items[6:s.max_items] %}{{ story(i) }}{% endfor %}</ul>
    </details>
    {% endif %}
    {% elif not s.briefing %}
    <p class="empty">Nothing new since the last edition.</p>
    {% endif %}

    {% if old_items %}
    <details><summary>Already in earlier editions ({{ old_items | length }})</summary>
      <ul class="stories older">
        {% for i in old_items[:30] %}
        <li><div class="src">{{ i.sources[0] }}</div><a class="hl" href="{{ i.link }}" target="_blank" rel="noopener">{{ i.title }}</a>
          <div class="meta">{{ i.published | shortdate }}</div></li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    {% set watched = s.pages | selectattr("status", "in", ["unchanged", "new"]) | list %}
    {% if watched %}
    <p class="watching">Monitoring {{ watched | length }} official page{{ "s" if watched | length > 1 }}, no changes:
      {% for p in watched %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a> (since {{ p.last_changed | shortdate }}){{ ", " if not loop.last }}{% endfor %}.</p>
    {% endif %}

    {% if s.errors %}
    <details class="errors"><summary>{{ s.errors | length }} source{{ "s" if s.errors | length > 1 }} unavailable</summary>
      <ul>{% for e in s.errors %}<li>{{ e }}</li>{% endfor %}</ul></details>
    {% endif %}
  </article>
  {% endfor %}

  <footer>
    <p>{% if d.ai %}Briefings are written by Claude from the linked articles. Check the source before acting on anything.{% else %}AI briefings are off: no Claude token or API key is set.{% endif %}</p>
    <p>Market data: Yahoo Finance. Interest rates: European Central Bank and Yahoo Finance. For information only, not investment advice.</p>
    <p><a href="archive.html">Past editions</a></p>
  </footer>
</main>

{% if vapid_public_key %}
<dialog class="notify" id="notify" aria-labelledby="notify-title">
  <h3 id="notify-title">Notifications</h3>
  <p>Get a notification each morning for the tabs you choose, in that tab's colour.</p>
  <p class="ios-hint" hidden><strong>On iPhone:</strong> first tap Share → <em>Add to Home Screen</em>, open the Brief from your home screen, then tap the bell again.</p>
  <div class="choices">
    <label class="choice"><input type="checkbox" value="today"><span class="dot"></span><span>☀️ Today</span></label>
    {% for s in d.sections %}<label class="choice" data-cat="{{ s.id }}"><input type="checkbox" value="{{ s.id }}"><span class="dot"></span><span>{{ s.emoji }} {{ s.short or s.title }}</span></label>
    {% endfor %}
  </div>
  <input type="text" id="notify-name" maxlength="40" placeholder="Name for this phone (optional)" autocomplete="off">
  <div class="row">
    <button class="btn" type="button" id="notify-on">Turn on</button>
    <button class="btn ghost" type="button" id="notify-off" hidden>Turn off</button>
    <button class="btn ghost" type="button" id="notify-close">Close</button>
  </div>
  <p class="status" id="notify-status" role="status"></p>
  <div id="notify-code" hidden>
    <p><strong>Last step, once per phone</strong> (and again if you change your tabs):</p>
    <ol>
      <li>Copy this code.</li>
      <li>On GitHub open <a id="notify-vars" target="_blank" rel="noopener">Settings → Secrets and variables → Actions → Variables</a>.</li>
      <li>Edit <strong>PUSH_SUBSCRIPTIONS</strong> (create it if it doesn't exist) and paste the code on its own line. Keep the other phone's line; replace this phone's old line if there is one.</li>
    </ol>
    <textarea id="notify-text" readonly></textarea>
    <div class="row"><button class="btn" type="button" id="notify-copy">Copy code</button></div>
  </div>
</dialog>
<script>
  // Web Push sign-up. The daily GitHub Action sends the notifications; this only
  // subscribes the phone and shows the code to register it.
  (() => {
    const KEY = "{{ vapid_public_key }}";
    const $ = id => document.getElementById(id);
    const dlg = $("notify"), status = $("notify-status");
    const boxes = [...dlg.querySelectorAll("input[type=checkbox]")];
    const store = (k, v) => { try { v === undefined ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch (e) {} };
    const load = k => { try { return localStorage.getItem(k); } catch (e) { return null; } };
    const say = (text, ok) => { status.textContent = text; status.classList.toggle("ok", !!ok); };
    const b64u = bytes => btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    const fromB64u = s => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0));
    const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone;
    const ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;

    // GitHub settings link: <owner>.github.io/<repo>/ -> github.com/<owner>/<repo>
    const owner = location.hostname.split(".")[0], repo = location.pathname.split("/")[1];
    $("notify-vars").href = `https://github.com/${owner}/${repo}/settings/variables/actions`;

    const saved = JSON.parse(load("brief-push-tabs") || "null");
    const lastTab = load("brief-tab");
    boxes.forEach(b => b.checked = saved ? saved.includes(b.value) : (b.value === "today" || b.value === lastTab));
    $("notify-name").value = load("brief-push-name") || "";

    function showCode(sub, tabs, name) {
      const j = sub.toJSON();
      const code = "brief1." + b64u(new TextEncoder().encode(JSON.stringify({ endpoint: j.endpoint, keys: j.keys, tabs, name })));
      $("notify-text").value = code;
      $("notify-code").hidden = false;
      store("brief-push-code", code);
    }

    async function refresh() {
      $("notify-off").hidden = true;
      $("notify-code").hidden = true;
      dlg.querySelector(".ios-hint").hidden = !(ios && !standalone);
      if (!supported) { say(ios && !standalone ? "" : "This browser can't receive notifications."); return; }
      const reg = await navigator.serviceWorker.getRegistration();
      const sub = reg && await reg.pushManager.getSubscription();
      if (sub && Notification.permission === "granted") {
        $("notify-off").hidden = false;
        $("notify-on").textContent = "Save tabs";
        say("Notifications are on for this phone.", true);
        const code = load("brief-push-code");
        if (code) { $("notify-text").value = code; $("notify-code").hidden = false; }
      } else {
        $("notify-on").textContent = "Turn on";
        say(Notification.permission === "denied" ? "Notifications are blocked. Allow them for this site in your phone's settings." : "");
      }
    }

    $("bell").addEventListener("click", () => { dlg.showModal(); refresh().catch(e => say(e.message)); });
    $("notify-close").addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", e => { if (e.target === dlg) dlg.close(); });

    $("notify-on").addEventListener("click", async () => {
      const tabs = boxes.filter(b => b.checked).map(b => b.value);
      const name = $("notify-name").value.trim();
      if (!tabs.length) { say("Choose at least one tab."); return; }
      if (!supported) { say(ios ? "Add the Brief to your Home Screen first (see above)." : "This browser can't receive notifications."); return; }
      try {
        if (await Notification.requestPermission() !== "granted") { say("Permission was not given."); return; }
        const reg = await navigator.serviceWorker.ready;
        let sub = await reg.pushManager.getSubscription();
        const key = fromB64u(KEY);
        const current = sub && sub.options.applicationServerKey && new Uint8Array(sub.options.applicationServerKey);
        if (sub && (!current || current.join() !== key.join())) { await sub.unsubscribe(); sub = null; }
        sub = sub || await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: key });
        store("brief-push-tabs", JSON.stringify(tabs));
        store("brief-push-name", name);
        showCode(sub, tabs, name);
        $("notify-off").hidden = false;
        $("notify-on").textContent = "Save tabs";
        say("Notifications are on. Finish the last step below.", true);
        reg.showNotification("The Daily Brief", { body: "Notifications are on. You'll get one per chosen tab each morning.",
                                                  icon: "icon-192.png", badge: "badge-72.png", tag: "welcome" }).catch(() => {});
      } catch (e) { say("Couldn't turn on notifications: " + e.message); }
    });

    $("notify-off").addEventListener("click", async () => {
      const reg = await navigator.serviceWorker.getRegistration();
      const sub = reg && await reg.pushManager.getSubscription();
      if (sub) await sub.unsubscribe();
      store("brief-push-code");
      await refresh();
      say("Notifications are off. You can delete this phone's line from PUSH_SUBSCRIPTIONS on GitHub.");
    });

    $("notify-copy").addEventListener("click", async () => {
      const t = $("notify-text");
      try { await navigator.clipboard.writeText(t.value); } catch (e) { t.select(); document.execCommand("copy"); }
      say("Code copied.", true);
    });
  })();
</script>
{% endif %}

<script>
  // Tabs: show one section at a time, remember the last one per device, swipe to switch.
  (() => {
    const KEY = "brief-tab";
    const panels = [...document.querySelectorAll(".panel")];
    const ids = panels.map(p => p.dataset.panel);
    const tabs = [...document.querySelectorAll(".tabs a")];
    const nav = document.querySelector(".tabs");
    let current = null;

    // Unread dots: which tabs this device has opened since the current edition.
    const edition = document.body.dataset.edition;
    let seen = {};
    try { seen = JSON.parse(localStorage.getItem("brief-seen") || "{}"); } catch (e) {}
    tabs.forEach(a => a.classList.toggle("unread", a.dataset.tab !== "today" && seen[a.dataset.tab] !== edition));

    // Warn when the newest edition is older than yesterday (e.g. a failed run).
    const ageDays = (Date.now() - new Date(document.body.dataset.date + "T12:00:00")) / 864e5;
    if (ageDays > 1.6 && location.pathname.split("/").pop().replace(/^$/, "index.html") === "index.html") {
      document.querySelector(".stale").hidden = false;
    }

    function show(id, { save = true, focus = null } = {}) {
      if (!ids.includes(id)) id = "today";
      seen[id] = edition;
      tabs.find(a => a.dataset.tab === id)?.classList.remove("unread");
      try { localStorage.setItem("brief-seen", JSON.stringify(seen)); } catch (e) {}
      panels.forEach(p => p.classList.toggle("active", p.dataset.panel === id));
      tabs.forEach(a => a.classList.toggle("active", a.dataset.tab === id));
      const tab = tabs.find(a => a.dataset.tab === id);
      if (tab) nav.scrollTo({ left: tab.offsetLeft - (nav.clientWidth - tab.clientWidth) / 2, behavior: current ? "smooth" : "auto" });
      if (save) { try { localStorage.setItem(KEY, id); } catch (e) {} }
      if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
      const target = focus && document.getElementById(focus);
      if (target) {
        target.scrollIntoView({ block: "center", behavior: current === id ? "smooth" : "auto" });
        target.classList.remove("flash"); void target.offsetWidth; target.classList.add("flash");
      } else if (current && current !== id) window.scrollTo({ top: 0 });
      current = id;
    }

    document.addEventListener("click", e => {
      const a = e.target.closest("a[data-tab]");
      if (!a) return;
      e.preventDefault();
      show(a.dataset.tab, { focus: a.dataset.focus });
    });

    // Desktop: arrow keys switch tabs; a vertical mouse wheel scrolls the tab and ticker strips sideways.
    addEventListener("keydown", e => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.target.closest("input, textarea, select")) return;
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const i = ids.indexOf(current) + (e.key === "ArrowRight" ? 1 : -1);
      if (i >= 0 && i < ids.length) show(ids[i]);
    });
    document.querySelectorAll(".tabs, .ticker-row").forEach(strip => strip.addEventListener("wheel", e => {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX) || strip.scrollWidth <= strip.clientWidth) return;
      e.preventDefault();
      strip.scrollLeft += e.deltaY;
    }, { passive: false }));
    addEventListener("hashchange", () => show(location.hash.slice(1)));

    let saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    show(location.hash.slice(1) || saved || "today", { save: false });
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";

    // Ticker: scroll slowly from right to left in a loop. It pauses while touched,
    // hovered or focused, so prices stay easy to tap and can still be swiped by hand.
    const row = document.querySelector(".ticker-row");
    if (row && row.children.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const originals = [...row.children];
      originals.forEach(n => {
        const copy = n.cloneNode(true);
        copy.setAttribute("aria-hidden", "true");
        copy.tabIndex = -1;
        row.appendChild(copy);
      });
      const SPEED = 35;  // pixels per second
      const loopWidth = () => row.children[originals.length].offsetLeft - row.children[0].offsetLeft;
      let pos = 0, last = null, paused = false, resume = null;
      const pause = () => { paused = true; clearTimeout(resume); };
      const unpause = (delay) => { clearTimeout(resume); resume = setTimeout(() => { pos = row.scrollLeft; paused = false; }, delay); };
      row.addEventListener("pointerenter", e => e.pointerType === "mouse" && pause());
      row.addEventListener("pointerleave", e => e.pointerType === "mouse" && unpause(600));
      row.addEventListener("touchstart", pause, { passive: true });
      row.addEventListener("touchend", () => unpause(2500), { passive: true });
      row.addEventListener("focusin", pause);
      row.addEventListener("focusout", () => unpause(600));
      row.addEventListener("wheel", () => { pause(); unpause(2500); }, { passive: true });
      const step = t => {
        if (last !== null && !paused && !document.hidden) {
          const w = loopWidth();
          pos += SPEED * Math.min(t - last, 100) / 1000;
          if (w > 0) pos = ((pos % w) + w) % w;
          row.scrollLeft = pos;
        }
        last = t;
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // Swipe left/right on the content to move between tabs (also over the price tiles).
    // Elements that scroll sideways themselves (wide <pre> blocks) keep their own swipe.
    let x0 = null, y0 = null;
    const main = document.querySelector("main");
    const scrollsSideways = el => {
      for (; el && el !== main; el = el.parentElement) if (el.scrollWidth > el.clientWidth + 2 &&
          /auto|scroll/.test(getComputedStyle(el).overflowX)) return true;
      return false;
    };
    main.addEventListener("touchstart", e => {
      if (e.touches.length > 1 || scrollsSideways(e.target)) { x0 = null; return; }
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
    }, { passive: true });
    main.addEventListener("touchend", e => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      x0 = null;
      if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      const i = ids.indexOf(current) + (dx < 0 ? 1 : -1);
      if (i >= 0 && i < ids.length) show(ids[i]);
    }, { passive: true });
  })();
</script>
</body>
</html>
