<!doctype html>
<html lang="en">
<head>
<title>The Daily Brief · {{ d.date_label }}</title>
{% include "_head.html.j2" %}
<style>
  /* One colour per tab (from config.yaml). Only category names use it; rules and accents stay neutral. */
  {% for s in d.sections if s.color %}[data-cat="{{ s.id }}"] { --cat: {{ s.color[0] }}; }
  {% endfor %}
  @media (prefers-color-scheme: dark) {
    {% for s in d.sections if s.color %}:root:not([data-theme="light"]) [data-cat="{{ s.id }}"] { --cat: {{ s.color[1] or s.color[0] }}; }
    {% endfor %}
  }
  {% for s in d.sections if s.color %}:root[data-theme="dark"] [data-cat="{{ s.id }}"] { --cat: {{ s.color[1] or s.color[0] }}; }
  {% endfor %}
  .panel-head > .kicker, .card > .kicker, .minute li > .kicker a { color: var(--cat, var(--teal)); }

  /* Section tabs */
  .tabs { display: flex; gap: 20px; overflow-x: auto; scrollbar-width: none; margin: 0 -16px;
          padding: 0 16px; -webkit-overflow-scrolling: touch; border-top: 1px solid var(--rule);
          overscroll-behavior-x: contain; scroll-padding: 0 32px; }
  /* Fade the edges of horizontal strips so it's clear there is more to scroll. */
  .tabs, .ticker-row { -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent);
                       mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent); }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs a { flex: none; padding: 10px 0 9px; font: 700 .72rem/1 var(--sans); letter-spacing: .08em;
            text-transform: uppercase; color: var(--muted); text-decoration: none;
            border-bottom: 3px solid transparent; white-space: nowrap; }
  .tabs a.active { color: var(--ink); border-bottom-color: var(--claret); }
  .tabs .count { margin-left: 4px; padding: 1px 5px; border-radius: 8px; background: var(--panel);
                 color: var(--muted); font-size: .64rem; letter-spacing: 0; }
  .tabs a.unread::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 5px;
                         border-radius: 50%; background: var(--claret); vertical-align: 2px; }
  .tabs a.active { color: var(--cat, var(--ink)); border-bottom-color: var(--ink); }
  .tabs a.active::after { display: none; }
  .tabs a.active .count { background: var(--ink); color: var(--paper); }

  /* Black market ticker */
  .ticker { background: var(--tick-bg); color: var(--tick-ink); }
  .ticker-row { display: flex; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px;
                -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  .ticker-row::-webkit-scrollbar { display: none; }
  .tick { flex: none; display: flex; align-items: baseline; gap: 7px; padding: 10px 16px 10px 0; margin-right: 16px;
          border-right: 1px solid #262626; font-size: .76rem; white-space: nowrap;
          color: inherit; text-decoration: none; }
  .tick:hover .tick-name, .tick:focus-visible .tick-name { color: var(--tick-ink); }
  .tick:last-child { border-right: 0; }
  .tick-name { color: var(--tick-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; font-size: .68rem; }
  .tick-val { font-weight: 700; }
  .tick .up { color: var(--tick-up); } .tick .down { color: var(--tick-down); } .tick .flat { color: var(--tick-muted); }

  /* Panels */
  .js .panel { display: none; }
  .js .panel.active { display: block; animation: fade .15s ease-out; }
  @keyframes fade { from { opacity: .5; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .js .panel.active { animation: none; } }
  .panel { padding-top: 22px; }
  .panel-head { padding-bottom: 12px; margin-bottom: 18px; border-bottom: 4px solid var(--rule-strong); }
  .panel-head h2 { margin: 6px 0 0; font: 600 clamp(1.7rem, 6.5vw, 2.3rem)/1.1 var(--serif); letter-spacing: -.015em; }
  .panel-head .meta { margin-top: 6px; }

  /* Front page */
  .dateline { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px 12px;
              padding: 8px 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong);
              font-size: .74rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); }
  .front-title { margin: 18px 0 2px; font: 600 clamp(1.9rem, 7.5vw, 2.8rem)/1.05 var(--serif); letter-spacing: -.02em; }
  .minute { margin: 20px 0 8px; padding: 16px 18px 6px; background: var(--panel); border-top: 4px solid var(--claret); }
  .minute ol { list-style: none; margin: 10px 0 0; padding: 0; }
  .minute li { padding: 10px 0 12px; border-top: 1px solid var(--rule); }
  .minute li:first-child { border-top: 0; padding-top: 2px; }
  .minute .kicker a { text-decoration: none; }
  .minute p { margin: 3px 0 0; font: 400 1.05rem/1.45 var(--serif); color: var(--ink); }

  .cards { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 18px; }
  @media (min-width: 720px) { .cards { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  .card { padding: 16px 0 18px; border-top: 1px solid var(--rule); }
  .card-title { display: block; margin: 6px 0 4px; font: 600 1.22rem/1.25 var(--serif); text-decoration: none; }
  .card-title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .standfirst { margin: 0; color: var(--ink-2); font-size: .92rem; }
  .card ul { list-style: none; margin: 10px 0 0; padding: 0; }
  .card li { padding: 7px 0 0; font: 500 .92rem/1.35 var(--serif); }
  .card li a { text-decoration: none; }
  .card li a:hover { text-decoration: underline; }
  .more { display: inline-block; margin-top: 10px; font: 700 .7rem/1 var(--sans); letter-spacing: .08em;
          text-transform: uppercase; color: var(--claret); text-decoration: none; }

  /* Section body */
  .brief { font-size: .98rem; }
  .brief ul { margin: 0; padding: 0; list-style: none; }
  .brief li { position: relative; padding: 0 0 12px 16px; margin: 0 0 12px; border-bottom: 1px solid var(--rule); }
  .brief li:last-child { border-bottom: 0; margin-bottom: 0; }
  .brief li::before { content: ""; position: absolute; left: 0; top: .55em; width: 7px; height: 7px; background: var(--claret); }
  .brief p { margin: 0 0 12px; }
  .brief strong { font: 700 1.02rem/1.3 var(--serif); }

  .foryou { margin: 18px 0 4px; padding: 14px 16px; background: var(--teal-soft); border-left: 4px solid var(--teal); }
  .foryou ul { margin: 8px 0 0; padding-left: 18px; }
  .foryou li { margin: 0 0 6px; font-size: .94rem; }
  .foryou li:last-child { margin-bottom: 0; }

  .radar { margin: 18px 0 4px; padding: 12px 16px; border: 1px solid var(--rule-strong); background: var(--card); }
  .radar ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .radar li { display: flex; gap: 12px; padding: 7px 0; border-top: 1px solid var(--rule); font-size: .92rem; }
  .radar li:first-child { border-top: 0; }
  .radar .when { flex: none; min-width: 64px; font-weight: 700; color: var(--claret); font-variant-numeric: tabular-nums; }
  .agenda { margin: 22px 0 6px; padding-top: 10px; border-top: 1px solid var(--rule-strong); }
  .agenda ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .agenda li { display: flex; gap: 14px; padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: .92rem; line-height: 1.4; }
  .agenda li:last-child { border-bottom: 0; }
  .agenda .when { flex: none; width: 96px; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .agenda .cat { margin-right: 4px; font: 700 .66rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase;
                 color: var(--cat, var(--teal)); text-decoration: none; }
  .explainer { margin: 18px 0 4px; padding: 0 16px; border: 1px solid var(--rule); background: var(--card); }
  .explainer summary { padding: 12px 0; color: var(--ink); font: 600 1rem/1.35 var(--serif); letter-spacing: 0; text-transform: none; }
  .explainer summary .kicker { margin-right: 6px; color: var(--teal); }
  .explainer summary::after { color: var(--claret); font-family: var(--sans); }
  .explainer p { margin: 0 0 14px; font-size: .94rem; color: var(--ink-2); }
  .stale { margin: 10px 0 0; padding: 8px 12px; font-size: .8rem; background: var(--alert-soft); color: var(--alert); }
  .alert { margin: 0 0 16px; padding: 12px 14px; background: var(--alert-soft); color: var(--alert); font-size: .9rem; }
  .alert a { font-weight: 700; }
  .alert pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .78rem; margin: 8px 0 0; color: var(--ink); }

  /* Data tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1px;
           margin: 0 0 22px; padding: 1px; }
  @media (max-width: 360px) { .tiles { grid-template-columns: 1fr 1fr; } }
  .tile { display: block; min-width: 0; padding: 11px 12px 10px; background: var(--card); text-decoration: none;
          box-shadow: 0 0 0 1px var(--rule); scroll-margin-top: 120px; }
  .tile:hover { background: var(--paper); }
  .tile.flash { animation: flash 1.6s ease-out; }
  @keyframes flash { 0%, 40% { box-shadow: 0 0 0 2px var(--claret); } 100% { box-shadow: 0 0 0 1px var(--rule); } }
  .tile-group { margin: 0 0 6px; }
  .tile-group + .tiles { margin-bottom: 18px; }
  .tile-name { font-size: .78rem; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .tile-sub { font-size: .68rem; color: var(--faint); }
  .tile-val { margin-top: 5px; font-size: 1.22rem; font-weight: 700; letter-spacing: -.01em; }
  .tile-chg { display: flex; flex-wrap: wrap; gap: 3px 8px; margin-top: 2px; font-size: .72rem; font-weight: 600; }
  .pill { display: inline-block; padding: 0 5px; border-radius: 3px; }
  .pill.up { background: var(--up-soft); } .pill.down { background: var(--down-soft); }
  .tile svg { display: block; width: 100%; height: 26px; margin-top: 7px; }
  .tile-empty { color: var(--faint); font-size: .78rem; margin-top: 8px; }

  /* Stories */
  .label { margin: 26px 0 0; padding-top: 8px; border-top: 1px solid var(--rule-strong); }
  .group-label { margin: 18px 0 0; color: var(--ink-2); }
  .stories { list-style: none; margin: 0; padding: 0; }
  .stories li { padding: 13px 0; border-bottom: 1px solid var(--rule); }
  .stories li:last-child { border-bottom: 0; }
  .stories .src { font: 700 .66rem/1.2 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--teal); }
  .stories a.hl { display: block; margin-top: 3px; font: 600 1.06rem/1.32 var(--serif); text-decoration: none; }
  .stories a.hl:hover { text-decoration: underline; text-underline-offset: 3px; }
  .stories .meta { margin-top: 3px; }
  .why { margin-top: 5px; font-size: .9rem; color: var(--ink-2); }
  .snippet { margin-top: 5px; font-size: .88rem; color: var(--ink-2);
             display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .empty { margin: 4px 0; color: var(--muted); font: italic 1rem var(--serif); }

  details { margin-top: 6px; }
  a, button, summary { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }

  /* Notification settings */
  dialog.notify { width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); overflow: auto;
                  padding: 20px; border: 0; border-radius: 14px; background: var(--card); color: var(--ink);
                  box-shadow: 0 20px 60px rgba(0,0,0,.35); }
  dialog.notify::backdrop { background: rgba(0,0,0,.45); }
  .notify h3 { margin: 0 0 4px; font: 600 1.4rem/1.2 var(--serif); }
  .notify p { margin: 6px 0; font-size: .9rem; color: var(--ink-2); }
  .notify .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; margin: 12px 0; }
  .notify label.choice { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: .9rem; cursor: pointer; }
  .notify label.choice input { width: 18px; height: 18px; accent-color: var(--cat, var(--claret)); }
  .notify label.choice .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--cat, var(--claret)); flex: none; }
  .notify input[type=text], .notify textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--rule); border-radius: 8px;
                                               background: var(--paper); color: var(--ink); font: 400 .9rem var(--sans); }
  .notify textarea { height: 86px; font: 400 .72rem/1.35 ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }
  .notify .row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .notify button.btn { padding: 10px 14px; border: 0; border-radius: 8px; font: 700 .85rem var(--sans); cursor: pointer;
                       background: var(--claret); color: #fff; }
  .notify button.btn.ghost { background: var(--panel); color: var(--ink); }
  .notify ol { margin: 8px 0; padding-left: 20px; font-size: .86rem; color: var(--ink-2); }
  .notify .status { min-height: 1.2em; font-size: .85rem; font-weight: 600; color: var(--alert); }
  .notify .status.ok { color: var(--up); }

  /* Saved, search, personalisation */
  .appbar-start { display: flex; gap: 4px; }
  .saved-btn { position: relative; }
  .badge { position: absolute; top: 4px; right: 2px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px;
           background: var(--claret); color: #fff; font: 700 .62rem/16px var(--sans); text-align: center; }
  .stories li { position: relative; padding-right: 40px; }
  .star { position: absolute; top: 8px; right: -6px; width: 40px; height: 40px; border: 0; background: none; cursor: pointer;
          color: var(--faint); font-size: 1.2rem; line-height: 40px; }
  .star::before { content: "☆"; }
  .star[aria-pressed="true"] { color: var(--claret); }
  .star[aria-pressed="true"]::before { content: "★"; }
  .foryou-tag { display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 3px; background: var(--panel);
                color: var(--ink-2); font: 700 .58rem/1.4 var(--sans); letter-spacing: .06em; text-transform: uppercase; vertical-align: 1px; }
  .search-box { width: 100%; padding: 12px 14px; border: 1px solid var(--rule-strong); border-radius: 10px; background: var(--card);
                color: var(--ink); font: 400 1rem var(--sans); }
  .hit-meta { font-size: .74rem; color: var(--muted); }
  .hit-meta .cat { font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--cat, var(--teal)); }
  .hit-text { margin-top: 4px; font-size: .9rem; color: var(--ink-2); }
  mark { background: var(--alert-soft); color: inherit; padding: 0 1px; }
  .week-tab { margin: 22px 0 0; padding-top: 10px; border-top: 1px solid var(--rule); }
  .week-tab > .kicker a { color: var(--cat, var(--teal)); text-decoration: none; }
  .week-tab .brief { margin-top: 10px; }
  .notify .modes { display: grid; gap: 4px; margin: 6px 0 12px; }
  .notify .modes label.choice { align-items: flex-start; font-size: .86rem; }
  .notify .modes input { margin-top: 2px; flex: none; }

  /* Whole stories are tappable and open the in-app reader */
  li[data-id] { cursor: pointer; }
  li[data-id]:active { background: var(--panel); }
  dialog.reader { width: 100%; max-width: 760px; height: 100%; max-height: 100%; margin: 0 auto; padding: 0; border: 0;
                  background: var(--paper); color: var(--ink); overscroll-behavior: contain; }
  dialog.reader::backdrop { background: rgba(0,0,0,.55); }
  @media (min-width: 800px) { dialog.reader { height: calc(100% - 48px); margin-top: 24px; border-radius: 14px; } }
  .reader-bar { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center;
                padding: calc(6px + var(--safe-top)) 10px 6px; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .reader-actions { display: flex; gap: 4px; }
  .reader-btn { min-width: 44px; height: 40px; padding: 0 10px; border: 0; border-radius: 10px; background: none;
                color: var(--ink); font: 600 .95rem var(--sans); cursor: pointer; }
  .reader-btn:active { background: var(--panel); }
  .r-star { font-size: 1.25rem; color: var(--faint); }
  .r-star::before { content: "☆"; }
  .r-star[aria-pressed="true"] { color: var(--claret); }
  .r-star[aria-pressed="true"]::before { content: "★"; }
  .reader-body { padding: 18px 18px calc(32px + var(--safe-bottom)); }
  .reader-body h2 { margin: 8px 0 8px; font: 600 clamp(1.5rem, 6vw, 2rem)/1.18 var(--serif); letter-spacing: -.01em; }
  #r-sec { color: var(--cat, var(--teal)); }
  #r-img { display: block; width: 100%; max-height: 300px; object-fit: cover; margin: 16px 0 4px; border-radius: 6px; background: var(--panel); }
  .r-block { margin: 18px 0 0; }
  .r-block p, .reader-body .foryou p { margin: 6px 0 0; font: 400 1.08rem/1.55 var(--serif); }
  .r-block p.meta { font: 400 .74rem var(--sans); color: var(--muted); }
  .source-btn { display: block; margin: 22px 0 0; padding: 14px 16px; border-radius: 10px; background: var(--claret); color: var(--paper);
                font: 700 .95rem/1.3 var(--sans); text-align: center; text-decoration: none; }
  .next-btn { display: block; width: 100%; margin: 10px 0 0; padding: 13px 16px; border: 1px solid var(--rule); border-radius: 10px;
              background: var(--card); color: var(--ink); font: 600 .9rem/1.35 var(--sans); text-align: left; cursor: pointer; }
  .next-btn span { display: block; font: 600 1rem/1.3 var(--serif); margin-top: 2px; }

  /* Morning essentials, listen, calendar, yield curve */
  .essentials { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 14px 0 0; }
  .ess { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--rule); background: var(--card);
         font-size: .78rem; color: var(--ink-2); text-decoration: none; }
  .ess-big { font: 700 1.25rem/1.2 var(--sans); color: var(--ink); }
  .kicker-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .listen { padding: 6px 10px; border: 1px solid var(--rule); border-radius: 999px; background: var(--card); color: var(--ink);
            font: 700 .72rem/1 var(--sans); letter-spacing: .04em; cursor: pointer; }
  .listen.playing { background: var(--claret); border-color: var(--claret); color: var(--paper); }
  .panel > .listen { display: block; margin: -6px 0 12px auto; }
  .speaking { background: var(--alert-soft); }
  .cal-link { font: 700 .72rem/1 var(--sans); color: var(--claret); text-decoration: none; }
  .curve-box { margin: 0 0 22px; padding: 12px 12px 8px; border: 1px solid var(--rule); background: var(--card); }
  .curve-box figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; align-items: baseline; }
  .curve-box .legend { font-size: .72rem; color: var(--muted); }
  .curve-box .legend i { display: inline-block; width: 16px; height: 0; margin: 0 4px 3px 8px; border-top: 2px solid var(--claret); }
  .curve-box .legend .l-m1 { border-top: 2px dotted var(--muted); }
  .curve-box .legend .l-y1 { border-top: 2px dashed var(--faint); }
  svg.curve { display: block; width: 100%; height: auto; margin-top: 6px; }

  /* Settings */
  .set-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
             padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .set-label { font: 700 .72rem/1.2 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .seg { display: inline-flex; padding: 3px; border-radius: 10px; background: var(--panel); }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 34px; padding: 0 10px;
              border-radius: 8px; font-size: .86rem; font-weight: 600; color: var(--ink-2); cursor: pointer; }
  .seg input:checked + span { background: var(--card); color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.18); }
  .seg input:focus-visible + span { outline: 2px solid var(--claret); }
  .set-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0;
                border-bottom: 1px solid var(--rule); font-size: .9rem; cursor: pointer; }
  .set-toggle input { flex: none; width: 20px; height: 20px; accent-color: var(--claret); }
  .tabs a.tab-hidden { display: none; }

  /* Tap a tile: 1-year chart */
  .tile[data-chart] { cursor: zoom-in; }
  dialog.chart-dlg { width: min(720px, calc(100vw - 24px)); padding: 16px 18px 14px; border: 0; border-radius: 14px;
                     background: var(--card); color: var(--ink); box-shadow: 0 20px 60px rgba(0,0,0,.35); }
  dialog.chart-dlg::backdrop { background: rgba(0,0,0,.5); }
  .chart-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .chart-head h3 { margin: 4px 0 0; font: 600 1.35rem/1.2 var(--serif); }
  .chart-val { margin: 8px 0 4px; font-size: .9rem; color: var(--ink-2); min-height: 1.3em; }
  .chart-val strong { font-size: 1.25rem; color: var(--ink); margin-right: 8px; }
  .chart-box { position: relative; height: min(52vh, 300px); touch-action: none; }
  .chart-box svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .chart-foot { display: flex; justify-content: space-between; margin-top: 8px; }
  .chart-foot a { color: var(--claret); font-weight: 700; text-decoration: none; }

  details summary { cursor: pointer; list-style: none; padding: 10px 0; font: 700 .7rem/1 var(--sans);
                    letter-spacing: .08em; text-transform: uppercase; color: var(--claret); }
  details summary::-webkit-details-marker { display: none; }
  details summary::after { content: " +"; }
  details[open] summary::after { content: " −"; }
  .older a.hl { font-size: .94rem; font-weight: 500; }
  .watching { margin-top: 14px; font-size: .76rem; color: var(--muted); }
  .watching a { color: var(--muted); }
  .errors ul { margin: 0; padding-left: 18px; font-size: .74rem; color: var(--muted); }
  .errors summary { color: var(--faint); }
</style>
</head>
<body data-edition="{{ d.date }} {{ d.generated_label }}" data-date="{{ d.date }}">
{%- macro story(i, sid) %}
      <li data-id="{{ i.id }}" data-sec="{{ sid }}" data-date="{{ i.published[:10] }}">
        <button class="star" type="button" aria-label="Save for later" aria-pressed="false"></button>
        <div class="src">{{ i.sources[0] }}{% if i.sources | length > 1 %} +{{ i.sources | length - 1 }}{% endif %}</div>
        <a class="hl" href="{{ i.link }}" target="_blank" rel="noopener">{{ i.title }}</a>
        {% if i.note %}<div class="why">{{ i.note }}</div>
        {% elif i.snippet %}<div class="snippet">{{ i.snippet }}</div>{% endif %}
        <div class="meta">{{ i.published | shortdate }}</div>
      </li>
{%- endmacro %}
{%- macro tile_id(sec, x) %}{{ tile_slug(sec, x) }}{% endmacro -%}
{%- set ticks = [] -%}
{%- for s in d.sections %}{% for q in s.quotes or [] if q.price is not none %}{% set _ = ticks.append((s.id, q)) %}{% endfor %}{% endfor -%}
{%- set rate_ticks = [] -%}
{%- for s in d.sections %}{% for r in (s.rates or [])[:4] if r.value is not none %}{% set _ = rate_ticks.append((s.id, r)) %}{% endfor %}{% endfor -%}

<header class="appbar">
  <div class="wrap">
    <div class="appbar-row">
      <div class="appbar-start">
        <a class="icon-btn" href="#search" data-tab="search" aria-label="Search past editions">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <a class="icon-btn saved-btn" href="#saved" data-tab="saved" aria-label="Saved stories">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span class="badge num" id="saved-count" hidden></span>
        </a>
      </div>
      <a class="brand" href="#today" data-tab="today">The Daily Brief<span>.</span></a>
      <div class="appbar-end">
        {% if vapid_public_key %}
        <button class="icon-btn" id="bell" type="button" aria-label="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        </button>
        {% endif %}
        <button class="icon-btn" id="settings-btn" type="button" aria-label="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
    </div>
    <nav class="tabs" aria-label="Sections">
      <a href="#today" data-tab="today">Today</a>
      {% if d.weekly %}<a href="#week" data-tab="week">This week</a>{% endif %}
      {% for s in d.sections %}<a href="#{{ s.id }}" data-tab="{{ s.id }}" data-cat="{{ s.id }}">{{ s.short or s.title }}{% if s.new_count %}<span class="count num">{{ s.new_count }}</span>{% endif %}</a>{% endfor %}
    </nav>
  </div>
</header>

{% if ticks or rate_ticks %}
<div class="ticker" aria-label="Markets">
  <div class="wrap"><div class="ticker-row">
    {% for sid, q in ticks %}
    <a class="tick num" href="#{{ sid }}" data-tab="{{ sid }}" data-focus="{{ tile_id(sid, q) }}"><span class="tick-name">{{ q.name }}</span><span class="tick-val">{{ q.price | price }}</span>{% if q.d1 is not none %}<span class="{{ q.d1 | updown }}">{{ q.d1 | pct(2) }}</span>{% endif %}</a>
    {% endfor %}
    {% for sid, r in rate_ticks %}
    <a class="tick num" href="#{{ sid }}" data-tab="{{ sid }}" data-focus="{{ tile_id(sid, r) }}"><span class="tick-name">{{ r.name }}</span><span class="tick-val">{{ r | rateval }}</span>{% if r.m1 is not none %}<span class="{{ r.m1 | updown }}">{{ r.m1 | bp }}</span>{% endif %}</a>
    {% endfor %}
  </div></div>
</div>
{% endif %}

<main class="wrap">

  <article class="panel" id="tab-today" data-panel="today">
    <div class="dateline"><span>{{ d.date_label }}</span><span>Edition {{ d.generated_label }}</span></div>
    <h1 class="front-title">Today's brief</h1>
    <div class="meta">{{ d.sections | sum(attribute="new_count") }} new stories across {{ d.sections | length }} sections</div>
    {% set mad = [] %}{% for s in d.sections %}{% for q in s.quotes or [] if q.symbol == "EURMAD=X" and q.price %}{% set _ = mad.append(q) %}{% endfor %}{% endfor %}
    {% if d.weather or mad %}
    <div class="essentials">
      {% if d.weather %}{% set w = d.weather %}<div class="ess"><span class="ess-big">{{ w.emoji }} {{ w.max }}°</span>
        <span>{{ w.place }} · {{ w.text }} · low {{ w.min }}°{% if w.rain is not none %} · rain {{ w.rain }}%{% endif %} · wind {{ w.wind }} km/h</span></div>{% endif %}
      {% if mad %}{% set q = mad[0] %}<a class="ess" href="#world" data-tab="world" data-focus="{{ tile_slug('world', q) }}"><span class="ess-big num">{{ "%.2f" | format(q.price) }}</span>
        <span>dirham per euro{% if q.d1 is not none %} · <span class="{{ q.d1 | updown }}">{{ q.d1 | pct(2) }}</span> today{% endif %}</span></a>{% endif %}
    </div>
    {% endif %}
    <div class="offline">You're offline. Showing the last saved edition.</div>
    <div class="stale" hidden>This edition is from {{ d.date_label }}. Today's run may have failed; check the Actions tab on GitHub.</div>

    {% if d.top %}
    <div class="minute">
      <div class="kicker-row"><div class="kicker" style="color:var(--claret)">In one minute</div>
        <button class="listen" type="button" data-listen=".minute" aria-label="Listen to the brief">▶ Listen</button></div>
      <ol>
        {% for b in d.top %}
        {% if b is mapping %}
        {% set sec = d.sections | selectattr("id", "equalto", b.section) | first %}
        <li data-cat="{{ b.section }}"><div class="kicker"><a href="#{{ b.section }}" data-tab="{{ b.section }}">{{ sec.short or sec.title if sec else b.section }}</a></div><p>{{ b.text }}</p></li>
        {% else %}<li><p>{{ b }}</p></li>{% endif %}
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    {% set coming = d | agenda %}
    {% if coming %}
    <div class="agenda">
      <div class="kicker-row"><div class="kicker" style="color:var(--claret)">Coming up</div>
        <a class="cal-link" id="cal-link" href="calendar.ics">＋ Add to my calendar</a></div>
      <ul>{% for e in coming %}
        <li><span class="when num">{{ e.date.strftime("%a %-d %b") }}{% if e.time %}<br><small>{{ e.time }}</small>{% endif %}</span>
          <span class="what"><a class="cat" data-cat="{{ e.section }}" href="#{{ e.section }}" data-tab="{{ e.section }}">{{ e.label }}</a> {{ e.what }}</span></li>
      {% endfor %}</ul>
    </div>
    {% endif %}

    <div class="cards">
      {% for s in d.sections %}
      {% set lead = s.briefing.summary | lead if s.briefing else none %}
      {% set fresh = s["items"] | selectattr("is_new") | list %}
      <div class="card" data-cat="{{ s.id }}">
        <div class="kicker">{{ s.short or s.title }}</div>
        {% if lead and lead.head %}
        <a class="card-title" href="#{{ s.id }}" data-tab="{{ s.id }}">{{ lead.head }}</a>
        {% if lead.body %}<p class="standfirst">{{ lead.body }}</p>{% endif %}
        {% elif fresh %}
        <a class="card-title" href="{{ fresh[0].link }}" data-article="{{ fresh[0].id }}" target="_blank" rel="noopener">{{ fresh[0].title }}</a>
        {% else %}
        <p class="empty">Nothing new today.</p>
        {% endif %}
        {% if fresh %}
        <ul>{% for i in fresh[(0 if lead and lead.head else 1):][:2] %}<li><a href="{{ i.link }}" data-article="{{ i.id }}" target="_blank" rel="noopener">{{ i.title }}</a></li>{% endfor %}</ul>
        {% endif %}
        <a class="more" href="#{{ s.id }}" data-tab="{{ s.id }}">Open {{ s.short or s.title }} →</a>
      </div>
      {% endfor %}
    </div>
  </article>

  {% if d.weekly %}
  <article class="panel" id="tab-week" data-panel="week">
    <div class="panel-head">
      <div class="kicker" style="color:var(--claret)">The week in review</div>
      <h2>This week</h2>
      <div class="meta">{{ d.weekly.range }}</div>
    </div>
    {% if d.weekly.overview %}
    <div class="minute"><div class="kicker" style="color:var(--claret)">The big picture</div>
      <ol>{% for b in d.weekly.overview %}<li>{{ b | md }}</li>{% endfor %}</ol></div>
    {% endif %}
    {% for s in d.sections if d.weekly.tabs[s.id] %}
    <section class="week-tab" data-cat="{{ s.id }}">
      <div class="kicker"><a href="#{{ s.id }}" data-tab="{{ s.id }}">{{ s.emoji }} {{ s.short or s.title }}</a></div>
      <div class="brief">{{ ("- " ~ d.weekly.tabs[s.id] | join("\n- ")) | md }}</div>
    </section>
    {% endfor %}
  </article>
  {% endif %}

  <article class="panel" id="tab-saved" data-panel="saved" data-extra>
    <div class="panel-head"><div class="kicker">On this phone</div><h2>Saved stories</h2>
      <div class="meta">Tap ☆ on any story to keep it here. Saved stories stay on this phone only.</div></div>
    <ul class="stories" id="saved-list"></ul>
    <p class="empty" id="saved-empty">Nothing saved yet.</p>
  </article>

  <article class="panel" id="tab-search" data-panel="search" data-extra>
    <div class="panel-head"><div class="kicker">Last 90 days</div><h2>Search</h2></div>
    <input class="search-box" id="search-box" type="search" placeholder="Search stories and briefings, e.g. ASML, GTA 6, CTIS" autocomplete="off" enterkeyhint="search">
    <p class="meta" id="search-status"></p>
    <ul class="stories" id="search-results"></ul>
    <p><a href="archive.html">Browse past editions by date →</a></p>
  </article>

  {% for s in d.sections %}
  <article class="panel" id="tab-{{ s.id }}" data-panel="{{ s.id }}" data-cat="{{ s.id }}">
    <div class="panel-head">
      <div class="kicker">{{ s.short or s.title }}</div>
      <h2>{{ s.title }}</h2>
      <div class="meta">{{ s.new_count }} new stor{{ "y" if s.new_count == 1 else "ies" }} · {{ d.date_label }}</div>
    </div>

    {% for p in s.pages if p.status in ("changed", "error") %}
    <div class="alert">
      {% if p.status == "changed" %}<div class="kicker" style="color:inherit">Official page changed</div>
        <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>
      {% else %}Couldn't check <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>{% endif %}
      {% if p.diff %}<pre>{{ p.diff }}</pre>{% endif %}
    </div>
    {% endfor %}

    {% if s.quotes %}
    {% set qgroups = s.quotes | map(attribute="group") | map("default", "", true) | unique | list %}
    {% for g in qgroups %}
    {% if g and qgroups | length > 1 %}<div class="kicker tile-group">{{ g }}</div>{% endif %}
    <div class="tiles">
      {% for q in s.quotes if (q.group or "") == g %}
      <a class="tile" data-chart id="{{ tile_id(s.id, q) }}" href="https://finance.yahoo.com/quote/{{ q.symbol | urlencode }}" target="_blank" rel="noopener">
        <div class="tile-name">{{ q.name }}</div>
        <div class="tile-sub">{{ q.symbol }}{% if q.unit %} · {{ q.unit }}{% endif %}</div>
        {% if q.price is not none %}
        <div class="tile-val num">{{ q.price | price }}</div>
        <div class="tile-chg num">
          {% if q.d1 is not none %}<span class="pill {{ q.d1 | updown }}">{{ q.d1 | pct(1) }}</span>{% endif %}
          {% if q.w1 is not none %}<span class="{{ q.w1 | updown }}">{{ q.w1 | pct(1) }} 1W</span>{% endif %}
          {% if q.m1 is not none %}<span class="{{ q.m1 | updown }}">{{ q.m1 | pct(1) }} 1M</span>{% endif %}
          {% if q.ytd is not none %}<span class="{{ q.ytd | updown }}">{{ q.ytd | pct(1) }} YTD</span>{% endif %}
        </div>
        {{ q.spark | spark }}
        {% if q.as_of %}<div class="tile-sub">as of {{ q.as_of | shortdate }}</div>{% endif %}
        {% else %}<div class="tile-empty">No data</div>{% endif %}
      </a>
      {% endfor %}
    </div>
    {% endfor %}
    {% endif %}
    {% if s.rates %}
    {% if s.rates_label %}<div class="kicker tile-group">{{ s.rates_label }}</div>{% endif %}
    <div class="tiles">
      {% for r in s.rates %}
      <a class="tile" data-chart id="{{ tile_id(s.id, r) }}" href="{{ r.url or ('https://fred.stlouisfed.org/series/' ~ (r.id | urlencode)) }}" target="_blank" rel="noopener">
        <div class="tile-name">{{ r.name }}</div>
        <div class="tile-sub">{{ r.region }}</div>
        {% if r.value is not none %}
        <div class="tile-val num">{{ r | rateval }}</div>
        <div class="tile-chg num">
          {% if r.m1 is not none %}<span><span class="pill {{ r.m1 | updown }}">{{ r.m1 | bp }}</span> 1M</span>{% endif %}
          {% if r.y1 is not none %}<span><span class="pill {{ r.y1 | updown }}">{{ r.y1 | bp }}</span> 1Y</span>{% endif %}
        </div>
        {{ r.spark | spark }}
        <div class="tile-sub">as of {{ r.as_of | shortdate }}</div>
        {% else %}<div class="tile-empty">No data</div>{% endif %}
      </a>
      {% endfor %}
    </div>
    {% endif %}


    {% if s.curve %}
    <figure class="curve-box">
      <figcaption><span class="kicker">Euro AAA yield curve</span>
        <span class="legend"><i class="l-now"></i>Today <i class="l-m1"></i>1 month ago <i class="l-y1"></i>1 year ago</span></figcaption>
      {{ s.curve | curve }}
      <div class="meta">Government spot rates, ECB · as of {{ s.curve.as_of | shortdate }} · 2s10s {{ ((s.curve.now[5] - s.curve.now[1]) * 100) | round | int }} bp, 10s30s {{ ((s.curve.now[8] - s.curve.now[5]) * 100) | round | int }} bp</div>
    </figure>
    {% endif %}

    {% if s.briefing %}
    {% if s.briefing.summary %}<button class="listen" type="button" data-listen="#tab-{{ s.id }} .brief" aria-label="Listen to this briefing">▶ Listen</button>{% endif %}
    <div class="brief">{{ s.briefing.summary | md }}</div>
    {% if s.briefing.on_radar %}
    <div class="radar">
      <div class="kicker">On the radar</div>
      <ul>{% for e in s.briefing.on_radar %}{% set when, _, what = e.partition(": ") %}<li>{% if what %}<span class="when">{{ when }}</span><span>{{ what }}</span>{% else %}<span>{{ e }}</span>{% endif %}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% if s.briefing.explainer and s.briefing.explainer.title and s.briefing.explainer.text %}
    <details class="explainer">
      <summary><span class="kicker">Explainer</span> {{ s.briefing.explainer.title }}</summary>
      <p>{{ s.briefing.explainer.text }}</p>
    </details>
    {% endif %}
    {% if s.briefing.for_you %}
    <div class="foryou">
      <div class="kicker">What it means for you</div>
      <ul>{% for f in s.briefing.for_you %}<li>{{ f }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% endif %}

    {% set new_items = s["items"] | selectattr("is_new") | list %}
    {% set old_items = s["items"] | rejectattr("is_new") | list %}
    {% if new_items and s.groups %}
    <div class="kicker label">Stories</div>
    {% for g in s.groups %}
    {% set gi = new_items | selectattr("group", "equalto", g) | list %}
    {% if gi %}
    <div class="kicker group-label">{{ g }}</div>
    <ul class="stories">{% for i in gi[:5] %}{{ story(i, s.id) }}{% endfor %}</ul>
    {% if gi | length > 5 %}
    <details><summary>More from {{ g }} ({{ gi[5:] | length }})</summary>
      <ul class="stories">{% for i in gi[5:] %}{{ story(i, s.id) }}{% endfor %}</ul>
    </details>
    {% endif %}
    {% endif %}
    {% endfor %}
    {% set other = new_items | rejectattr("group", "in", s.groups) | list %}
    {% if other %}
    <div class="kicker group-label">Other</div>
    <ul class="stories">{% for i in other[:5] %}{{ story(i, s.id) }}{% endfor %}</ul>
    {% endif %}
    {% elif new_items %}
    <div class="kicker label">Stories</div>
    <ul class="stories">{% for i in new_items[:6] %}{{ story(i, s.id) }}{% endfor %}</ul>
    {% if new_items | length > 6 %}
    <details><summary>More stories ({{ new_items[6:s.max_items] | length }})</summary>
      <ul class="stories">{% for i in new_items[6:s.max_items] %}{{ story(i, s.id) }}{% endfor %}</ul>
    </details>
    {% endif %}
    {% elif not s.briefing %}
    <p class="empty">Nothing new since the last edition.</p>
    {% endif %}

    {% if old_items %}
    <details><summary>Already in earlier editions ({{ old_items | length }})</summary>
      <ul class="stories older">
        {% for i in old_items[:30] %}
        <li data-id="{{ i.id }}" data-sec="{{ s.id }}" data-date="{{ i.published[:10] }}"><div class="src">{{ i.sources[0] }}</div><a class="hl" href="{{ i.link }}" target="_blank" rel="noopener">{{ i.title }}</a>
          <div class="meta">{{ i.published | shortdate }}</div></li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    {% set watched = s.pages | selectattr("status", "in", ["unchanged", "new"]) | list %}
    {% if watched %}
    <p class="watching">Monitoring {{ watched | length }} official page{{ "s" if watched | length > 1 }}, no changes:
      {% for p in watched %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a> (since {{ p.last_changed | shortdate }}){{ ", " if not loop.last }}{% endfor %}.</p>
    {% endif %}

    {% if s.errors %}
    <details class="errors"><summary>{{ s.errors | length }} source{{ "s" if s.errors | length > 1 }} unavailable</summary>
      <ul>{% for e in s.errors %}<li>{{ e }}</li>{% endfor %}</ul></details>
    {% endif %}
  </article>
  {% endfor %}

  <footer>
    <p>{% if d.ai %}Briefings are written by Claude from the linked articles. Check the source before acting on anything.{% else %}AI briefings are off: no Claude token or API key is set.{% endif %}</p>
    <p>Market data: Yahoo Finance. Interest rates: European Central Bank and Yahoo Finance. For information only, not investment advice.</p>
    <p><a href="archive.html">Past editions</a> · <a href="#" id="reset-interests">Reset reading preferences</a></p>
    <p>Stories you open on this phone are used, on this phone only, to move similar stories up.</p>
  </footer>
</main>

<dialog class="notify settings" id="settings" aria-labelledby="settings-title">
  <h3 id="settings-title">Settings</h3>
  <p>Saved on this phone only.</p>
  <div class="set-row"><span class="set-label">Theme</span>
    <div class="seg" role="radiogroup" aria-label="Theme">
      <label><input type="radio" name="set-theme" value="system"><span>System</span></label>
      <label><input type="radio" name="set-theme" value="light"><span>Light</span></label>
      <label><input type="radio" name="set-theme" value="dark"><span>Dark</span></label>
    </div></div>
  <div class="set-row"><span class="set-label">Text size</span>
    <div class="seg" role="radiogroup" aria-label="Text size">
      <label><input type="radio" name="set-size" value="90"><span style="font-size:.8rem">A</span></label>
      <label><input type="radio" name="set-size" value="100"><span style="font-size:.95rem">A</span></label>
      <label><input type="radio" name="set-size" value="112"><span style="font-size:1.1rem">A</span></label>
      <label><input type="radio" name="set-size" value="125"><span style="font-size:1.25rem">A</span></label>
    </div></div>
  <div class="set-row"><span class="set-label">Open on</span>
    <div class="seg" role="radiogroup" aria-label="Open on">
      <label><input type="radio" name="set-start" value="last"><span>Last tab</span></label>
      <label><input type="radio" name="set-start" value="today"><span>Today</span></label>
    </div></div>
  <label class="set-toggle"><span>Scrolling price ticker</span><input type="checkbox" id="set-ticker"></label>
  <label class="set-toggle"><span>"For you": move stories like the ones I open to the top</span><input type="checkbox" id="set-foryou"></label>
  <div class="set-label" style="margin-top:14px">Tabs to show</div>
  <div class="choices" id="set-tabs">
    {% for s in d.sections %}<label class="choice" data-cat="{{ s.id }}"><input type="checkbox" value="{{ s.id }}"><span class="dot"></span><span>{{ s.emoji }} {{ s.short or s.title }}</span></label>
    {% endfor %}
  </div>
  <div class="row">
    <button class="btn" type="button" id="settings-done">Done</button>
    {% if vapid_public_key %}<button class="btn ghost" type="button" id="settings-notify">Notifications…</button>{% endif %}
    <button class="btn ghost" type="button" onclick="location.reload()">Reload</button>
  </div>
  <p class="meta" style="margin-top:12px"><a href="#" id="settings-reset">Reset all settings</a>
    <a href="#" id="settings-lock" hidden> · Lock this phone (ask for the passphrase again)</a></p>
</dialog>

<dialog class="reader" id="reader" aria-labelledby="r-title">
  <div class="reader-bar">
    <button class="reader-btn" type="button" id="r-back" aria-label="Back to the list">‹ Back</button>
    <div class="reader-actions">
      <button class="reader-btn r-star" type="button" id="r-star" aria-pressed="false" aria-label="Save for later"></button>
      <button class="reader-btn" type="button" id="r-share">Share</button>
    </div>
  </div>
  <div class="reader-body">
    <div class="kicker" id="r-sec"></div>
    <h2 id="r-title"></h2>
    <div class="meta" id="r-meta"></div>
    <img id="r-img" alt="" hidden referrerpolicy="no-referrer">
    <section class="r-block" id="r-sum-box"><div class="kicker">Summary</div><p id="r-sum"></p>
      <p class="meta">Written by Claude from the article. Check the source for details.</p></section>
    <section class="foryou" id="r-note-box"><div class="kicker">Why it matters</div><p id="r-note"></p></section>
    <section class="r-block" id="r-snip-box"><div class="kicker">From the feed</div><p id="r-snip"></p></section>
    <a class="source-btn" id="r-link" target="_blank" rel="noopener"></a>
    <button class="next-btn" type="button" id="r-next"></button>
  </div>
</dialog>
<script type="application/json" id="articles">{{ articles | tojson }}</script>

<dialog class="chart-dlg" id="chart-dlg" aria-labelledby="chart-title">
  <div class="chart-head"><div><div class="kicker" id="chart-sub"></div><h3 id="chart-title"></h3></div>
    <button class="icon-btn" type="button" id="chart-close" aria-label="Close">✕</button></div>
