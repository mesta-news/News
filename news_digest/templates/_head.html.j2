<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121316" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Brief">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="icon-32.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>
  :root {
    --bg: #f7f4ee; --surface: #fffdf9; --text: #17181b; --text-2: #4a4b50; --muted: #7a776f;
    --line: #e4ded2; --line-strong: #17181b; --accent: #1d5c8c; --accent-soft: #e6eef5;
    --up: #157f3b; --down: #c0362c; --up-soft: #e3f2e8; --down-soft: #f9e5e2;
    --alert: #8a5a00; --alert-soft: #fbf1dc;
    --serif: "Iowan Old Style", "Charter", "Palatino Linotype", Palatino, "Source Serif Pro", Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-left: env(safe-area-inset-left, 0px); --safe-right: env(safe-area-inset-right, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121316; --surface: #191a1e; --text: #ecebe6; --text-2: #c2c0b8; --muted: #8d8b84;
      --line: #2a2b30; --line-strong: #ecebe6; --accent: #7fb2e0; --accent-soft: #1d2733;
      --up: #4fc27c; --down: #ff7b6b; --up-soft: #16281d; --down-soft: #2f1a18;
      --alert: #f0c060; --alert-soft: #2a2414;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--safe-top) + 104px); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 var(--sans);
         -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  a { color: inherit; }
  .wrap { max-width: 760px; margin: 0 auto;
          padding: 0 calc(18px + var(--safe-right)) 0 calc(18px + var(--safe-left)); }
  .num { font-variant-numeric: tabular-nums; }

  /* App bar */
  .appbar { position: sticky; top: 0; z-index: 10; padding-top: var(--safe-top);
            background: var(--bg);
            background: color-mix(in srgb, var(--bg) 92%, transparent);
            -webkit-backdrop-filter: saturate(180%) blur(14px); backdrop-filter: saturate(180%) blur(14px);
            border-bottom: 1px solid var(--line); }
  .appbar-row { display: flex; align-items: center; justify-content: space-between; height: 50px; }
  .brand { font: 700 1.2rem/1 var(--serif); letter-spacing: -.01em; text-decoration: none; }
  .brand span { color: var(--accent); }
  .actions { display: flex; gap: 2px; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
              border: 0; background: none; color: var(--text-2); border-radius: 10px; cursor: pointer; }
  .icon-btn:active { background: var(--line); }
  .icon-btn svg { width: 20px; height: 20px; }
  .refresh { display: none; }
  @media (display-mode: standalone) { .refresh { display: inline-flex; } }
  .tabs { display: flex; gap: 22px; overflow-x: auto; scrollbar-width: none; margin: 0 -18px;
          padding: 0 18px; -webkit-overflow-scrolling: touch; }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs a { flex: none; padding: 9px 0 11px; font-size: .82rem; font-weight: 600; color: var(--muted);
            text-decoration: none; border-bottom: 2px solid transparent; white-space: nowrap; }
  .tabs a.active { color: var(--text); border-bottom-color: var(--accent); }
  .tabs .count { font-weight: 500; color: var(--muted); margin-left: 3px; font-size: .75rem; }

  /* Typography */
  .kicker { font: 700 .7rem/1.2 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .meta { color: var(--muted); font-size: .78rem; }
  footer { margin: 48px 0 0; padding: 20px 0 calc(32px + var(--safe-bottom));
           border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; line-height: 1.55; }
  footer p { margin: 0 0 8px; }
  .offline { display: none; margin: 12px 0 0; padding: 8px 12px; border-radius: 8px; font-size: .8rem;
             background: var(--alert-soft); color: var(--alert); }
  body.is-offline .offline { display: block; }
</style>
<script>
  if ("serviceWorker" in navigator) {
    addEventListener("load", () => navigator.serviceWorker.register("sw.js").catch(() => {}));
  }
  addEventListener("DOMContentLoaded", () => {
    const sync = () => document.body.classList.toggle("is-offline", !navigator.onLine);
    addEventListener("online", sync); addEventListener("offline", sync); sync();
  });
</script>
