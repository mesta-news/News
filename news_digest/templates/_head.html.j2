<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fff1e5" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111112" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Brief">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="icon-32.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<script>
  // Apply this phone's settings (theme, text size) before the page is drawn, so nothing flashes.
  (() => {
    const root = document.documentElement;
    root.classList.add("js");
    let set = {};
    try { set = JSON.parse(localStorage.getItem("brief-settings") || "{}"); } catch (e) {}
    if (set.theme === "light" || set.theme === "dark") {
      root.dataset.theme = set.theme;
      root.style.colorScheme = set.theme;
      addEventListener("DOMContentLoaded", () => document.querySelectorAll('meta[name="theme-color"]').forEach(m =>
        m.content = set.theme === "dark" ? "#111112" : "#fff1e5"));
    }
    if (set.size) root.style.setProperty("--fs", set.size + "%");
  })();
</script>
<style>
  /* Salmon paper, ink text, claret and teal accents; a black market ticker. */
  :root {
    --paper: #fff1e5; --panel: #f2dfce; --card: #fff8f1; --ink: #1a1817; --ink-2: #33302e;
    --muted: #66605c; --faint: #8f8782; --rule: #e0cdbc; --rule-strong: #1a1817;
    --claret: #990f3d; --teal: #0d7680; --teal-soft: #e3eeee;
    --up: #0a7a3b; --down: #c1272d; --up-soft: #dcefe2; --down-soft: #f8dcdb;
    --alert: #7a4b00; --alert-soft: #fae6c3;
    --tick-bg: #000; --tick-ink: #f3f3f3; --tick-muted: #9a9a9a; --tick-up: #3ddc84; --tick-down: #ff5a4f;
    --serif: "Iowan Old Style", "Charter", "Georgia", "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-left: env(safe-area-inset-left, 0px); --safe-right: env(safe-area-inset-right, 0px);
  }
  /* Dark palette: follows the phone, unless Settings forces light or dark. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #111112; --panel: #1c1c1e; --card: #19191b; --ink: #f2eee9; --ink-2: #d9d4ce;
      --muted: #a39d97; --faint: #7d7873; --rule: #2c2b2b; --rule-strong: #f2eee9;
      --claret: #f0668f; --teal: #4fc0c8; --teal-soft: #15292b;
      --up: #3ec27a; --down: #ff6b61; --up-soft: #12271b; --down-soft: #301615;
      --alert: #f2c26b; --alert-soft: #2c2312;
    }
  }
  :root[data-theme="dark"] {
      --paper: #111112; --panel: #1c1c1e; --card: #19191b; --ink: #f2eee9; --ink-2: #d9d4ce;
      --muted: #a39d97; --faint: #7d7873; --rule: #2c2b2b; --rule-strong: #f2eee9;
      --claret: #f0668f; --teal: #4fc0c8; --teal-soft: #15292b;
      --up: #3ec27a; --down: #ff6b61; --up-soft: #12271b; --down-soft: #301615;
      --alert: #f2c26b; --alert-soft: #2c2312;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }  /* an element marked hidden never shows, whatever its own display rule */
  html { -webkit-text-size-adjust: 100%; font-size: var(--fs, 100%); }  /* text size from Settings */
  body { margin: 0; background: var(--paper); color: var(--ink); font: 1rem/1.55 var(--sans);
         -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  a { color: inherit; }
  .wrap { max-width: 980px; margin: 0 auto;
          padding: 0 calc(16px + var(--safe-right)) 0 calc(16px + var(--safe-left)); }
  .num { font-variant-numeric: tabular-nums; }
  .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--faint); }

  /* Masthead bar */
  .appbar { position: sticky; top: 0; z-index: 20; padding-top: var(--safe-top);
            background: var(--paper); border-bottom: 1px solid var(--rule); }
  .appbar-row { display: grid; grid-template-columns: 84px 1fr 84px; align-items: center; height: 52px; }
  .appbar-end { display: flex; justify-content: flex-end; gap: 4px; }
  .brand { justify-self: center; font: 700 1.3rem/1 var(--serif); letter-spacing: -.01em; text-decoration: none; }
  .brand span { color: var(--claret); }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
              border: 0; background: none; color: var(--ink-2); border-radius: 10px; cursor: pointer; }
  .icon-btn:active { background: var(--panel); }
  .icon-btn svg { width: 20px; height: 20px; }
  .refresh { display: none; }
  @media (display-mode: standalone) { .refresh { display: inline-flex; } }

  .kicker { font: 700 .68rem/1.2 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--teal); }
  .meta { color: var(--muted); font-size: .78rem; }
  footer { margin: 44px 0 0; padding: 18px 0 calc(28px + var(--safe-bottom));
           border-top: 1px solid var(--rule); color: var(--muted); font-size: .76rem; line-height: 1.55; }
  footer p { margin: 0 0 8px; }
  .offline { display: none; margin: 10px 0 0; padding: 8px 12px; border-radius: 6px; font-size: .8rem;
             background: var(--alert-soft); color: var(--alert); }
  body.is-offline .offline { display: block; }
</style>
<script>
  if ("serviceWorker" in navigator) {
    addEventListener("load", () => navigator.serviceWorker.register("sw.js").catch(() => {}));
  }
  addEventListener("DOMContentLoaded", () => {
    const sync = () => document.body.classList.toggle("is-offline", !navigator.onLine);
    addEventListener("online", sync); addEventListener("offline", sync); sync();
  });
</script>
