<!doctype html>
<html lang="en">
<head>
<title>Past editions · The Daily Brief</title>
{% include "_head.html.j2" %}
<style>
  .masthead { padding: 28px 0 18px; border-bottom: 3px double var(--rule-strong); }
  .masthead h1 { margin: 8px 0 0; font: 600 2.2rem/1.1 var(--serif); letter-spacing: -.02em; }
  .editions { list-style: none; margin: 0; padding: 0; }
  .editions li { border-bottom: 1px solid var(--rule); }
  .editions a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
                padding: 16px 0; text-decoration: none; }
  .editions .day { font: 600 1.08rem/1.3 var(--serif); }
  .appbar-row { grid-template-columns: 44px 1fr 44px; }
  .editions + footer { border-top: 0; margin-top: 24px; }
</style>
</head>
<body>
<header class="appbar">
  <div class="wrap">
    <div class="appbar-row">
      <a class="icon-btn" href="index.html" aria-label="Latest edition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
      </a>
      <a class="brand" href="index.html">The Daily Brief<span>.</span></a>
      <span></span>
    </div>
  </div>
</header>
<main class="wrap">
  <div class="masthead">
    <div class="kicker">Archive</div>
    <h1>Past editions</h1>
  </div>
  <ul class="editions">
    {% for e in entries %}
    <li><a href="{{ e.date }}.html"><span class="day">{{ e.label }}</span><span class="meta num">{{ e.new_count }} stories</span></a></li>
    {% endfor %}
  </ul>
  <footer><p><a href="index.html">Latest edition</a></p></footer>
</main>
</body>
</html>
